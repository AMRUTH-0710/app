# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ==============================================================================
# DESIGNATED SINGLE ADMIN CREDENTIALS
# Configure your admin email and password.
# Only this designated account will receive { admin: true } authorization.
# ==============================================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=

# (OPTIONAL) Firebase Admin Service Account Key path for live Firebase Auth cloud syncing
GOOGLE_APPLICATION_CREDENTIALS=
